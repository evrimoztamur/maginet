# Copy to ~/.config/maginet/android-release.env and restrict permissions (chmod 600).
# Do not commit the filled file. Quote shell values; this file is sourced by Bash.
export MAGINET_KEYSTORE='/absolute/path/to/upload.jks'
export MAGINET_STORE_PASSWORD=''
export MAGINET_KEY_ALIAS=''
export MAGINET_KEY_PASSWORD=''
export MAGINET_PLAY_PUBLIC_KEY_FILE='/absolute/path/to/play-billing-public-key.txt'
# A version code not already uploaded to Play. Confirm against Console before building.
export MAGINET_VERSION_CODE='1'
export MAGINET_VERSION_NAME='1.0'
# For an authenticated Publisher API upload, when configured:
export GOOGLE_APPLICATION_CREDENTIALS='/absolute/path/to/play-service-account.json'
